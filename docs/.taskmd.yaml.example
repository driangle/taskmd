# Example .taskmd.yaml configuration file
#
# This file can be placed in:
#   - A project directory (./.taskmd.yaml) - found from any subdirectory
#   - Your home directory (~/.taskmd.yaml) - used only when no project file is found
#
# Only ONE file is loaded: the nearest .taskmd.yaml walking up from the current
# directory, else ~/.taskmd.yaml. The two are not merged.
#
# Precedence order (highest to lowest):
#   1. Command-line flags
#   2. TASKMD_* environment variables
#   3. The loaded .taskmd.yaml (or the file given by --config)
#   4. Built-in defaults

# Default directory to search for task files
# This sets the default value for the --dir flag
dir: ./tasks

# Web server configuration
web:
  # Default port for the web dashboard server
  # This sets the default value for the --port flag in 'taskmd web start'
  port: 8080

  # Bind address for the web dashboard server
  # This sets the default value for the --host flag in 'taskmd web start'
  # 127.0.0.1 (default) accepts connections only from this machine.
  # 0.0.0.0 accepts them on every network interface -- note the API is
  # unauthenticated and can rewrite task files unless readonly is true.
  host: 127.0.0.1

  # Automatically open browser when starting the web server
  # This sets the default value for the --open flag in 'taskmd web start'
  auto_open_browser: false

  # Serve the dashboard without editing
  # This sets the default value for the --readonly flag in 'taskmd web start'
  # Recommended whenever host is not 127.0.0.1: it disables
  # PUT /api/tasks/{id}, so the API cannot rewrite task files.
  readonly: false

# Enable or disable task worklogs
# When true (default), agents are encouraged to create and maintain worklog files
# alongside tasks to record progress, decisions, and blockers.
# Set to false to disable worklog behavior in agent workflows.
worklogs: true

# Worktree scope: unified (default) or isolated. In a git repo with multiple
# worktrees, 'unified' merges task state across all of them for reads: each
# task shows its most advanced status, and 'next' skips tasks claimed in a
# sibling worktree. Writes always stay in the current worktree, and
# single-worktree repos and non-git directories are unaffected. Set to
# 'isolated' if your worktrees keep intentionally independent task states;
# override per invocation with --worktree-scope isolated.
# worktree_scope: unified

# Additional directories to skip when scanning (beyond built-in skip list)
# ignore:
#   - "tmp"
#   - "cache"

# Workflow mode: "solo" (default) or "pr-review"
# workflow: solo

# Glob patterns to exclude from TODO/FIXME scanning
# todos:
#   exclude:
#     - "**/*_test.go"

# Web: start in read-only mode (disables editing)
# web:
#   readonly: false

# ID generation strategy
# id:
#   strategy: sequential    # sequential, prefixed, random, or ulid
#   padding: 3              # zero-padding width for sequential
#   # prefix: "dr-"         # prefix for prefixed strategy (used literally)
#   # length: 6             # length for random/ulid strategies

# Effort vocabulary for the 'effort' task field, ordered lowest to highest.
# Defaults to [small, medium, large] when omitted; setting it replaces those
# entirely, so existing task files must use the new values.
# The order matters: it drives comparison filters (--filter "effort>=m"), the
# column order of 'board --group-by effort', 'list --sort effort', scoring in
# 'next', and which value 'next --quick-wins' selects (always the lowest).
# effort: [xs, s, m, l, xl]

# Scope definitions for the 'touches' field (used by tracks command)
# scopes:
#   cli/graph:
#     description: "Graph visualization"
#     paths:
#       - "apps/cli/internal/graph/"

# Phase definitions
# phases:
#   - id: v0.2                # referenced by the task `phase` field
#     name: "v0.2 – Core CLI" # display name (required)
#     description: "Core CLI features"
#     due: 2026-04-01

# Sync configuration - fetch tasks from external sources
# Run 'taskmd sync down' to pull tasks, or 'taskmd sync down --dry-run' to preview changes.
# sync:
#   sources:
#     # GitHub Issues source
#     - name: github
#       project: "owner/repo"            # GitHub owner/repo
#       token_env: GITHUB_TOKEN          # Env var holding a GitHub personal access token
#       output_dir: ./tasks/github       # Where to write synced task files
#       field_map:
#         status:
#           open: pending
#           closed: completed
#         labels_to_tags: true
#         assignee_to_owner: true
#       filters:
#         state: open                    # Only sync open issues
#
#     # Jira Cloud source
#     - name: jira
#       project: "PROJ"                  # Jira project key
#       base_url: https://myteam.atlassian.net  # Jira Cloud instance URL
#       token_env: JIRA_API_TOKEN        # Env var holding a Jira API token
#       user_env: JIRA_USER_EMAIL        # Env var holding your Jira account email
#       output_dir: ./tasks/jira
#       field_map:
#         status:
#           To Do: pending
#           In Progress: in-progress
#           Done: completed
#         priority:
#           High: high
#           Medium: medium
#           Low: low
#         labels_to_tags: true
#         assignee_to_owner: true
#       filters:
#         jql: 'status != "Done"'        # Additional JQL filter (ANDed with project)

# Note: Only project-level settings are supported in config files. Per-invocation
# preferences like 'format' are CLI-only ('verbose' and 'quiet' are honoured
# here but flagged by 'taskmd validate'; prefer the flags).
# See the full list of supported options in the configuration reference.
