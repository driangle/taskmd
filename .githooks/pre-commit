#!/bin/sh

# Run taskmd validate before committing
if command -v taskmd >/dev/null 2>&1; then
    taskmd validate
    if [ $? -ne 0 ]; then
        echo "taskmd validate failed. Fix the issues above before committing."
        exit 1
    fi
else
    echo "Warning: taskmd not found, skipping validation"
fi

# Run compile + lint checks for all projects
make check-lite
if [ $? -ne 0 ]; then
    echo "check-lite failed. Fix the issues above before committing."
    exit 1
fi

# Ensure apps/cli's sdk/go pin has not fallen behind the in-repo SDK.
# go.work hides a stale pin locally; external `go install` does not. See issue #8.
./scripts/check-sdk-pin.sh --staged
if [ $? -ne 0 ]; then
    echo "check-sdk-pin failed. Bump the pin as shown above before committing."
    exit 1
fi
